.PHONY : messages/message.s

# target to generate assembly for a file
messages/message.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\smart_battery.dir\build.make CMakeFiles/smart_battery.dir/messages/message.c.s
.PHONY : messages/message.c.s

startup_stm32g491xx.obj: startup_stm32g491xx.s.obj
.PHONY : startup_stm32g491xx.obj

